use ai.core
use agent.core

fn score(x, y) -> float:
    return x * x + y

task Flow:
    let total = 0
    repeat 5 times:
        let total = total + 2
    if total > 8:
        log "big"
    else:
        log "small"
    log total
    log score(3, 4)
    let ticks = 0
    while ticks < 2 max_iters(10):
        let ticks = ticks + 1
    log ticks
    while 1 == 1 max_iters(3):
        log "spin"
    log "done"
